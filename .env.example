# =============================================================
#  DFS Edge - environment configuration
# =============================================================
#  HOW TO USE:
#    1. Copy this file to ".env"  ->  cp .env.example .env
#    2. Fill in the values below.
#    3. NEVER commit .env  (it is already in .gitignore).
# =============================================================

# ---- Anthropic (Claude) --------------------------------------
# Get a key at https://console.anthropic.com  ->  API Keys
# Without this the app still works; the AI Analysis panel is
# just disabled.
ANTHROPIC_API_KEY=

# Which model to use for slate analysis.
# claude-sonnet-5 = best balance of speed/cost/quality.
# claude-opus-5   = smarter, slower, more expensive.
ANTHROPIC_MODEL=claude-sonnet-5


# ---- The Odds API (betting lines) ----------------------------
# Get a key at https://the-odds-api.com
#   Free tier      = 500 credits/month  (a few pulls per day)
#   $30/mo "20K"   = 20,000 credits/month  <- recommended
# Leave blank to run without betting lines.
ODDS_API_KEY=

# Which sportsbooks to pull, comma separated.
# Common: draftkings, fanduel, betmgm, caesars, pinnacle
ODDS_BOOKMAKERS=draftkings,fanduel

# Set to "true" to also pull player props (home runs, hits,
# total bases, strikeouts). Props cost 1 credit PER GAME per
# market, so this burns credits much faster. Requires a paid plan.
ODDS_FETCH_PROPS=false


# ---- Caching -------------------------------------------------
# How long (seconds) to reuse a cached API response before
# fetching again. Higher = fewer API calls = lower cost.
CACHE_TTL_SCHEDULE=900        # 15 min  - today's games
CACHE_TTL_STATS=21600         # 6 hours - season stat splits
CACHE_TTL_ODDS=600            # 10 min  - betting lines
CACHE_TTL_WEATHER=1800        # 30 min  - forecasts

# Where the local cache database lives (relative to backend/).
DB_PATH=data/dfsedge.db


# ---- Historical data store (Supabase Postgres) ----------------
# Optional. Powers a permanent archive (real RotoWire uploads, game
# results) that survives past the local cache's TTLs. Leave blank to
# run without it -- the app works fine either way.
# Get this from your Supabase project dashboard: click "Connect" at
# the top of the page -> Connection string tab -> Session pooler.
SUPABASE_DB_URL=


# ---- Server --------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
