# ---- Secrets: never commit these ----
.env
.env.local
*.env
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Local data / cache ----
# NOTE: these are anchored with a leading slash on purpose. A bare
# "data/" would also match backend/app/data/ -- which is SOURCE CODE
# (the ballpark reference table), not cache -- and silently drop it
# from the repo.
/backend/data/
/data/
*.db
*.sqlite
*.sqlite3
/cache/

# Real DraftKings contest-standings exports (the user's own downloaded
# archives). Kept locally on purpose -- every ownership/projection
# backtest in scripts/ reads them -- but never pushed: they're large
# binaries and they carry other real DK users' usernames.
/Contest Data/

# ---- Node / frontend ----
node_modules/
dist/
.vite/
*.log
npm-debug.log*

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
